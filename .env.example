# Copy this file to .env.local and fill in the values.
# .env.local is never committed. On Vercel, add the same names under
# Project Settings > Environment Variables.

# --- Supabase (Project Settings > API Keys / Data API) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public address of the app (used in invite links and email confirmations).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets --------------------------------------------------
# Supabase secret key (starts with sb_secret_). NEVER expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Texting ---------------------------------------------------------------
# "simulator" (default): nothing real is sent; use the in-app Simulator.
# "twilio": real calls and texts through your Twilio account.
SMS_PROVIDER=simulator
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# Area code for new business numbers.
DEFAULT_AREA_CODE=843
# Only for a Twilio TRIAL account texting your own verified phones before
# carrier registration is approved. Leave false in production.
ALLOW_UNREGISTERED_TEXTING=false

# --- Your admin access ------------------------------------------------------
# Comma-separated emails that can open /admin (carrier registration, all businesses).
PLATFORM_ADMIN_EMAILS=you@example.com

# --- Legal pages (shown on /privacy, /terms, /sms-terms) -------------------
# NEXT_PUBLIC_LEGAL_COMPANY_NAME=Your Company LLC
# NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# NEXT_PUBLIC_LEGAL_ADDRESS=Summerville, SC

# --- Tests only -----------------------------------------------------------
# Connection string for the database used by tests/db (use your DEV project,
# never production). Supabase: Connect > Session pooler. Tests roll back all
# changes, so no test data is left behind.
# TEST_DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Added in later milestones -------------------------------------------
# CRON_SECRET=                  (M3)
# STRIPE_SECRET_KEY=            (M10)
# STRIPE_WEBHOOK_SECRET=        (M10)
